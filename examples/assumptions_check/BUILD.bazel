# Demonstrates the Print Assumptions gate (issue #45, REQ-004, CC-003): a
# rocq_proof_test only proves the kernel accepted the proof SCRIPT -- it says
# nothing about whether that script quietly rests on `Admitted` or a
# project-local `Axiom`. rocq_assumptions_test closes that gap.
#
# The negative cases (Admitted/Axiom declarations, including the #57 planted
# file with no Theorem/Lemma at all, and an empty file) must FAIL. They run
# against real coqc in rocq/private/assumptions_check_test.py, which CI runs
# with ASSUMPTIONS_REQUIRE_COQC=1 so they cannot skip -- not shipped here as
# standing targets, since a target expected to fail would make
# `bazel test //...` permanently red.

load("@rules_rocq_rust//rocq:defs.bzl", "rocq_assumptions_test", "rocq_library", "rocq_proof_test")

rocq_library(
    name = "clean",
    srcs = ["clean.v"],
)

rocq_proof_test(
    name = "clean_test",
    srcs = [],
    deps = [":clean"],
)

rocq_assumptions_test(
    name = "clean_assumptions_test",
    deps = [":clean"],
)
